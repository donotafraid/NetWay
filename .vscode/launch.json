{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LLDB Debug",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/file_platform",  // 对齐 CMake 输出路径
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "ASAN_OPTIONS",
          "value": "detect_leaks=1:abort_on_error=1"
        }
      ],
      "preLaunchTask": "cmake-build",
      "postDebugTask": "reset-sanitizers",
      "sourceMap": {
        "/mnt": "${workspaceFolder}"  // WSL 路径映射
      }
    }
  ]
}