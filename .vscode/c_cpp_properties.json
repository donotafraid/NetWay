{
  "configurations": [
    {
      "name": "Clang",
      "includePath": [
        "${workspaceFolder}/include/**",
        "${workspaceFolder}/build/**",  
        "/usr/include/**",
        "/usr/lib/llvm-17/include/**"  
      ],
      "defines": [
        "__clang__=1"
      ],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++17",           
      "intelliSenseMode": "linux-clang-x64",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json"
    }
  ],
  "version": 4
}