+// bench/bench_recovery.cpp
+//
+// Disconnect/recovery latency distribution.
+//
+//   ./bench_recovery --api-cycles 30 --restart-cycles 20
+//   ./bench_recovery --endpoint opc.tcp://127.0.0.1:4840 --api-cycles 50
+//
+// Two measurements:
+//   api_reconnect_ms      explicit disconnect() + connect() round trip
+//   restart_recovery_ms   server outage -> watchdog-driven healthy again
+//                         (only when the benchmark starts its own server)
+//
+// Prints P50/P90/P99/max for each distribution on stdout.
+#include "bench_common.h"
+
+#include "OPCUAPacking/ua.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+struct Args {
+  size_t apiCycles = 30;
+  size_t restartCycles = 20;
+  uint16_t port = 4891;
+  std::string endpoint;
+};
+
+Args parse(int argc, char **argv) {
+  Args a;
+  for (int i = 1; i < argc; ++i) {
+    const std::string k = argv[i];
+    auto next = [&]() -> const char * {
+      return (i + 1 < argc) ? argv[++i] : nullptr;
+    };
+    if (k == "--api-cycles") {
+      a.apiCycles = std::strtoul(next(), nullptr, 10);
+    } else if (k == "--restart-cycles") {
+      a.restartCycles = std::strtoul(next(), nullptr, 10);
+    } else if (k == "--port") {
+      a.port = static_cast<uint16_t>(std::strtoul(next(), nullptr, 10));
+    } else if (k == "--endpoint") {
+      a.endpoint = next();
+    } else {
+      std::fprintf(stderr, "unknown argument: %s\n", k.c_str());
+      std::exit(2);
+    }
+  }
+  return a;
+}
+
+void printDistribution(const char *name, std::vector<double> samples) {
+  if (samples.empty()) {
+    std::printf("%s n=0\n", name);
+    return;
+  }
+  samples = bench::sorted(std::move(samples));
+  std::printf("%s n=%zu p50=%.1fms p90=%.1fms p99=%.1fms max=%.1fms "
+              "mean=%.1fms\n",
+              name, samples.size(), bench::percentile(samples, 50.0),
+              bench::percentile(samples, 90.0),
+              bench::percentile(samples, 99.0), samples.back(),
+              bench::mean(samples));
+}
+
+bool waitHealthy(OPC_UA_Client &client, double timeoutMs) {
+  const auto t0 = bench::Clock::now();
+  while (bench::msSince(t0) < timeoutMs) {
+    if (client.isHealthy().is_success())
+      return true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  return client.isHealthy().is_success();
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  const Args args = parse(argc, argv);
+
+  std::unique_ptr<bench::Server> server;
+  std::string url = args.endpoint;
+  if (url.empty()) {
+    server = std::make_unique<bench::Server>(args.port);
+    url = "opc.tcp://127.0.0.1:" + std::to_string(args.port);
+  }
+
+  ClientConfig cfg;
+  cfg.applyProfile(ClientConfig::PROFILE_LOCAL);
+  cfg.watchdogIntervalMs = 1000; // fastest the config validation allows
+  cfg.giveUpThresholdMs = 60000;
+
+  auto created = OPC_UA_Client::create(url, cfg, /*useDefault=*/false);
+  if (created.is_fail()) {
+    std::fprintf(stderr, "create failed: %s\n",
+                 created.get_error()->codeName());
+    return 2;
+  }
+  auto client = std::move(*created.get());
+
+  // ---- 1) explicit disconnect() + connect() round trip ----
+  std::vector<double> apiSamples;
+  apiSamples.reserve(args.apiCycles);
+  for (size_t i = 0; i < args.apiCycles; ++i) {
+    const auto t0 = bench::Clock::now();
+    const auto d = client->disconnect();
+    const auto c = client->connect();
+    const double ms = bench::msSince(t0);
+    if (d.is_fail() || c.is_fail()) {
+      std::fprintf(stderr, "api cycle %zu failed: d=%s c=%s\n", i,
+                   d.is_fail() ? d.get_error()->codeName() : "ok",
+                   c.is_fail() ? c.get_error()->codeName() : "ok");
+      continue;
+    }
+    apiSamples.push_back(ms);
+  }
+  printDistribution("api_reconnect_ms", std::move(apiSamples));
+
+  // ---- 2) server outage -> watchdog recovery ----
+  if (server) {
+    std::vector<double> recoverySamples;
+    recoverySamples.reserve(args.restartCycles);
+    for (size_t i = 0; i < args.restartCycles; ++i) {
+      server->stopServing();
+
+      // Wait until the client observed the outage; the watchdog drives this.
+      const auto down0 = bench::Clock::now();
+      while (bench::msSince(down0) < 30000.0 &&
+             client->isHealthy().is_success()) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+      }
+
+      server->startServing();
+      const auto up0 = bench::Clock::now();
+      const bool recovered = waitHealthy(*client, 60000.0);
+      const double ms = bench::msSince(up0);
+      if (!recovered) {
+        std::fprintf(stderr, "restart cycle %zu did not recover\n", i);
+        continue;
+      }
+      recoverySamples.push_back(ms);
+    }
+    printDistribution("restart_recovery_ms", std::move(recoverySamples));
+  } else {
+    std::fprintf(stderr,
+                 "no --endpoint server owned by this process; restart sweep "
+                 "skipped\n");
+  }
+
+  (void)client->shutdown();
+  return 0;
+}
diff --git a/bench/bench_rss.cpp b/bench/bench_rss.cpp
new file mode 100644
index 0000000..d39d595
--- /dev/null
+++ b/bench/bench_rss.cpp
@@ -0,0 +1,143 @@
+// bench/bench_rss.cpp
+//
+// Long-run soak: sample resident memory while issuing batch reads, so a 24h
+// run produces an RSS curve and a call/error count.
+//
+//   ./bench_rss --hours 24 --interval 60 --hz 1 > rss_24h.csv
+//   ./bench_rss --hours 0.01 --interval 5 --hz 20      # ~36 s smoke run
+//   ./bench_rss --endpoint opc.tcp://10.0.0.5:4840 --hours 24
+//
+// stdout is CSV: elapsed_s,rss_kb,calls,errors  (one row per interval).
+#include "bench_common.h"
+
+#include "OPCUAPacking/ua.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+struct Args {
+  double hours = 24.0;
+  double intervalSec = 60.0;
+  double hz = 1.0;
+  size_t batch = 16;
+  uint16_t port = 4892;
+  std::string endpoint;
+};
+
+Args parse(int argc, char **argv) {
+  Args a;
+  for (int i = 1; i < argc; ++i) {
+    const std::string k = argv[i];
+    auto next = [&]() -> const char * {
+      return (i + 1 < argc) ? argv[++i] : nullptr;
+    };
+    if (k == "--hours") {
+      a.hours = std::strtod(next(), nullptr);
+    } else if (k == "--interval") {
+      a.intervalSec = std::strtod(next(), nullptr);
+    } else if (k == "--hz") {
+      a.hz = std::strtod(next(), nullptr);
+    } else if (k == "--batch") {
+      a.batch = std::strtoul(next(), nullptr, 10);
+    } else if (k == "--port") {
+      a.port = static_cast<uint16_t>(std::strtoul(next(), nullptr, 10));
+    } else if (k == "--endpoint") {
+      a.endpoint = next();
+    } else {
+      std::fprintf(stderr, "unknown argument: %s\n", k.c_str());
+      std::exit(2);
+    }
+  }
+  if (a.hours <= 0.0)
+    a.hours = 0.01;
+  if (a.intervalSec <= 0.0)
+    a.intervalSec = 1.0;
+  if (a.hz <= 0.0)
+    a.hz = 1.0;
+  if (a.batch == 0)
+    a.batch = 1;
+  return a;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  const Args args = parse(argc, argv);
+
+  std::unique_ptr<bench::Server> server;
+  std::string url = args.endpoint;
+  if (url.empty()) {
+    server = std::make_unique<bench::Server>(args.port);
+    url = "opc.tcp://127.0.0.1:" + std::to_string(args.port);
+  }
+
+  ClientConfig cfg;
+  cfg.applyProfile(ClientConfig::PROFILE_LOCAL);
+  cfg.watchdogIntervalMs = 1000;
+  cfg.giveUpThresholdMs = 60000;
+
+  auto created = OPC_UA_Client::create(url, cfg, /*useDefault=*/false);
+  if (created.is_fail()) {
+    std::fprintf(stderr, "create failed: %s\n",
+                 created.get_error()->codeName());
+    return 2;
+  }
+  auto client = std::move(*created.get());
+
+  std::vector<OPC_UA_Client::ReadValue> reads;
+  for (size_t i = 0; i < args.batch; ++i)
+    reads.push_back({1, "BenchInt", S7DataType::INT});
+
+  const double totalSec = args.hours * 3600.0;
+  const double periodMs = 1000.0 / args.hz;
+
+  std::printf("elapsed_s,rss_kb,calls,errors\n");
+  std::fflush(stdout);
+
+  const auto start = bench::Clock::now();
+  double nextSample = 0.0;
+  unsigned long long calls = 0;
+  unsigned long long errors = 0;
+
+  while (true) {
+    const double elapsed = bench::msSince(start) / 1000.0;
+    if (elapsed >= totalSec)
+      break;
+
+    const auto loop0 = bench::Clock::now();
+    const auto r = client->batchRead(reads);
+    ++calls;
+    if (r.is_fail())
+      ++errors;
+
+    const double now = bench::msSince(start) / 1000.0;
+    if (now >= nextSample) {
+      std::printf("%.1f,%ld,%llu,%llu\n", now, bench::residentKb(), calls,
+                  errors);
+      std::fflush(stdout);
+      nextSample += args.intervalSec;
+      if (nextSample <= now) // long stall: resynchronise instead of bursting
+        nextSample = now + args.intervalSec;
+    }
+
+    const double busy = bench::msSince(loop0);
+    if (busy < periodMs)
+      std::this_thread::sleep_for(
+          std::chrono::duration<double, std::milli>(periodMs - busy));
+  }
+
+  std::printf("%.1f,%ld,%llu,%llu\n", bench::msSince(start) / 1000.0,
+              bench::residentKb(), calls, errors);
+  std::fprintf(stderr, "soak finished: hours=%.3f calls=%llu errors=%llu\n",
+               args.hours, calls, errors);
+
+  (void)client->shutdown();
+  return 0;
+}
