diff --git a/bench/bench_server.cpp b/bench/bench_server.cpp
new file mode 100644
index 0000000..218f6b4
--- /dev/null
+++ b/bench/bench_server.cpp
@@ -0,0 +1,91 @@
+// bench/bench_server.cpp
+//
+// Standalone open62541 server used as the peer of the long-run RSS soak.
+//
+//   ./bench_server --port 4892                  # run until SIGINT/SIGTERM
+//   ./bench_server --port 4892 --seconds 60     # auto-exit (smoke test)
+//
+// Why a separate process: bench_rss reads its own /proc/self/statm. When the
+// server runs in the same process, the "client RSS" curve also contains the
+// server's allocations, so it cannot prove anything about the client. Running
+// the server out of process and pointing bench_rss at it with --endpoint makes
+// the curve client-only.
+//
+// Prints exactly one readiness line, then stays quiet:
+//   READY port=<port> pid=<pid>
+#include "bench_common.h"
+
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+
+#if defined(_WIN32)
+#include <process.h>
+#define BENCH_GETPID _getpid
+#else
+#include <unistd.h>
+#define BENCH_GETPID getpid
+#endif
+
+namespace {
+
+std::atomic<bool> g_stop{false};
+
+void onSignal(int) { g_stop.store(true, std::memory_order_release); }
+
+struct Args {
+  uint16_t port = 4892;
+  std::string node = "BenchInt";
+  double seconds = 0.0; // 0 = run until signalled
+};
+
+Args parse(int argc, char **argv) {
+  Args a;
+  for (int i = 1; i < argc; ++i) {
+    const std::string k = argv[i];
+    auto next = [&]() -> const char * {
+      return (i + 1 < argc) ? argv[++i] : nullptr;
+    };
+    if (k == "--port") {
+      a.port = static_cast<uint16_t>(std::strtoul(next(), nullptr, 10));
+    } else if (k == "--node") {
+      const char *v = next();
+      a.node = v ? v : a.node;
+    } else if (k == "--seconds") {
+      a.seconds = std::strtod(next(), nullptr);
+    } else {
+      std::fprintf(stderr, "unknown argument: %s\n", k.c_str());
+      std::exit(2);
+    }
+  }
+  return a;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  const Args args = parse(argc, argv);
+
+  std::signal(SIGINT, onSignal);
+  std::signal(SIGTERM, onSignal);
+
+  bench::Server server(args.port, args.node);
+
+  std::printf("READY port=%u pid=%ld\n", args.port,
+              static_cast<long>(BENCH_GETPID()));
+  std::fflush(stdout);
+
+  const auto start = bench::Clock::now();
+  while (!g_stop.load(std::memory_order_acquire)) {
+    if (args.seconds > 0.0 && bench::msSince(start) >= args.seconds * 1000.0)
+      break;
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+  }
+
+  return 0;
+}
diff --git a/docs/limitations.md b/docs/limitations.md
index 54aa360..6ac7e8b 100644
--- a/docs/limitations.md
+++ b/docs/limitations.md
@@ -51,11 +51,23 @@
 - **benchmark 已提供，但不在 CI 门禁内。** `bench/` 与 `scripts/run_bench.sh`
   覆盖 8 线程 `batchRead`/`batchWrite` 的 P50/P99、断线恢复耗时分布、
   长时间 RSS 曲线。这些是观测值，需要人工跑并归档原始结果，CI 不设阈值。
+  `scripts/check_rss.py` 与 `scripts/run_netem_matrix.sh` 提供可复现的
+  PASS/FAIL 判据，但仍需人工在有 root / 长时间窗口的机器上触发。
+- **单次延迟 p99 不可复现。** 同一份代码、同一台机器，单次 8 线程 p99 可以在
+  30ms~62ms 之间波动；`bench_latency --repeats N` 的中位数才是可引用值。
+  8 线程吞吐并不随线程数线性扩展：`m_sdkMutex` 与 open62541 内部 clientMutex
+  把同步服务调用串行化，线程越多 p99 越大（本机实测 t=1 p99≈0.2ms，
+  t=8 p99≈31ms）。
+- **RSS soak 必须让 server 跑在独立进程。** `bench_rss` 读的是自身
+  `/proc/self/statm`；若用默认的 in-process server，server 的分配会混进
+  “客户端”曲线。`scripts/run_bench.sh` 现在用 `bench_server` 把 server 放到
+  子进程，`bench_rss --endpoint` 只测客户端。
 - **真实网络抖动需要人工注入。** `scripts/netem_faults.sh` 用 `tc netem` /
-  `iptables` 在回环上制造高延迟、丢包与半开连接；数据来自本机回环，
-  不代表真实工业现场的多跳网络。
+  `iptables` 在回环上制造高延迟、丢包与半开连接；`scripts/run_netem_matrix.sh`
+  把四种故障串成一次可判定的矩阵。数据来自本机回环，不代表真实工业现场的
+  多跳网络。
 - **`bench_rss` 的长时间曲线依赖进程存活。** 机器重启 / OOM 会截断曲线，
-  归档时保留 CSV 原始数据。
+  归档时保留 CSV 原始数据；`check_rss.py --min-hours` 用于拒绝被截断的曲线。
 
 
 
